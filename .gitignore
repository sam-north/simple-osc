# Build output: compiled plugins (.vst3 / .clap), the standalone app, and intermediate files.
# Everything Cargo produces goes here; it's regenerated by `cargo build`.
/target/

# Editor and IDE settings
.vscode/
.idea/
*.swp
*~

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# Debug symbols and crash dumps, if a build ever drops them outside target/
*.pdb
*.dmp
